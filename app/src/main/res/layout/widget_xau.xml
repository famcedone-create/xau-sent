<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="XAUUSD Analisi 5m"
            android:textColor="@color/text_main"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/refresh"
            android:layout_width="44dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="↻"
            android:textColor="@color/text_main"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/sentiment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FF 5m: BUY --% | SELL --%"
        android:textColor="@color/text_main"
        android:textStyle="bold"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/entries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="FF 10m: BUY --% | SELL --%"
        android:textColor="@color/text_main"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/flow_x"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="X 5m: BUY --% | SELL --%"
        android:textColor="@color/text_main"
        android:textStyle="bold"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/flow_x_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="X 10m: BUY --% | SELL --%"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/trend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="TREND 5m: --"
        android:textColor="@color/text_main"
        android:textStyle="bold"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="STATO: --"
        android:textColor="@color/text_main"
        android:textStyle="bold"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/chart_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="GRAFICO 5m"
        android:textColor="@color/text_muted"
        android:textStyle="bold"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/chart_1m" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="1m" android:textColor="@color/text_main" android:textSize="11sp" />
        <TextView android:id="@+id/chart_5m" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="5m" android:textColor="@color/text_main" android:textSize="11sp" />
        <TextView android:id="@+id/chart_15m" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="15m" android:textColor="@color/text_main" android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/chart"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="4dp"
        android:scaleType="fitXY"
            android:contentDescription="Grafico XAUUSD 5m BiQuote" />

    <TextView
        android:id="@+id/key_levels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="LIVELLI CHIAVE"
        android:textColor="@color/text_muted"
        android:textStyle="bold"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/levels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="Resistenza 1: --  |  Supporto 1: --"
        android:textColor="@color/text_main"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/fvg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="FVG BUY: --  •  SELL: --"
        android:textColor="@color/text_main"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/ai_insight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="LETTURA AI: non disponibile"
        android:textColor="@color/text_muted"
        android:textSize="10sp" />
</LinearLayout>
